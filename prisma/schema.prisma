generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Internal staffing ONLY — never store commercial customers here.
model User {
  id             Int               @id @default(autoincrement())
  email          String            @unique
  password       String
  role           String            @default("EMPLOYEE")
  employeeName   String
  activeStatus   Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignedJobs   JobMetadata[]
  createdJobs    JobMetadata[]     @relation("CreatedJobs")
  createdSurveys SurveyReport[]    @relation("CreatedSurveys")
  createdQuotations QuotationInvoice[] @relation("CreatedQuotations")
  createdExpenses Expense[]       @relation("CreatedExpenses")
  createdPayments PaymentReceived[] @relation("CreatedPayments")
  createdWorkCompletions WorkCompletion[] @relation("CreatedWorkCompletions")
  createdBankApprovals   BankApproval[]   @relation("CreatedBankApprovals")
  gmailAccounts  GmailAccount[]
  createdTickets Ticket[]        @relation("CreatedTickets")
  userComments   Comment[]       @relation("UserComments")
  adminComments  Comment[]       @relation("AdminComments")

  // Employee Expense Reconciliation & Statements Relations
  uploadedStatements BankStatement[] @relation("UploadedStatements")
  createdOtherExpenses OtherExpense[] @relation("CreatedOtherExpenses")
  reconciliationAudits ReconciliationAudit[] @relation("AdminReconciliationAudits")
}

/// Gmail OAuth connection and sync tracking.
model GmailAccount {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailEmail     String    @unique
  accessToken    String
  refreshToken   String
  expiryDate     BigInt
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  syncedEmailIds String    @default("[]")
  purposeNotes   String?
  tickets        Ticket[]
}

/// Automated Gmail ingestion stream.
model Ticket {
  id             Int          @id @default(autoincrement())
  gmailAccountId Int?
  gmailAccount   GmailAccount? @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)
  gmailMessageId String       @unique
  serialNo       String       @unique
  exactDate      DateTime
  time           String
  subject        String
  sender         String
  createdAt      DateTime     @default(now())
  status         String       @default("PENDING") // PENDING, RELEVANT, IRRELEVANT
  statusLastChangedBy String?
  jobMetadata    JobMetadata?
  createdById    Int?
  createdBy      User?        @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: SetNull)
}

/// Commercial customers and site branches live here — NOT in User.
model JobMetadata {
  id                 Int                @id @default(autoincrement())
  ticketId           Int                @unique
  ticket             Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  clientName         String
  branchName         String
  personOfContact    String
  workNature         String
  assignedEmployeeId Int?
  assignedEmployee   User?              @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  manualEnteredBy    String?
  createdById        Int?
  createdBy          User?        @relation("CreatedJobs", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  paymentProgress    Int?           @default(0)
  paymentStatus      String?        @default("PENDING")
  surveyReport       SurveyReport?
  quotationInvoices  QuotationInvoice[]
  expenses           Expense[]
  payments           PaymentReceived[]
  workCompletion     WorkCompletion?
  bankApproval       BankApproval?
}

model SurveyReport {
  id            Int         @id @default(autoincrement())
  jobMetadataId Int         @unique
  jobMetadata   JobMetadata @relation(fields: [jobMetadataId], references: [id], onDelete: Cascade)
  createdById   Int?
  createdBy     User?       @relation("CreatedSurveys", fields: [createdById], references: [id], onDelete: SetNull)
  reportText    String
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model QuotationInvoice {
  id            Int             @id @default(autoincrement())
  jobMetadataId Int
  jobMetadata   JobMetadata     @relation(fields: [jobMetadataId], references: [id], onDelete: Cascade)
  createdById   Int?
  createdBy     User?           @relation("CreatedQuotations", fields: [createdById], references: [id], onDelete: SetNull)
  poNumber      String?
  status        String          @default("PENDING")
  documentType  String          @default("QUOTATION")
  lineItems     String          @default("[]")
  imageUrl      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime    @updatedAt
}

model Expense {
  id                 Int                @id @default(autoincrement())
  jobMetadataId      Int
  jobMetadata        JobMetadata        @relation(fields: [jobMetadataId], references: [id], onDelete: Cascade)
  createdById        Int?
  createdBy          User?              @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  amount             Float
  imageUrl           String?
  summaryNotes       String
  category           String?            // Fuel, Spare Parts, Transport, Site Expense, Maintenance, Other
  expenseDate        DateTime?
  status             String             @default("UNMATCHED") // UNMATCHED, MATCHED, PARTIALLY_MATCHED, REVIEW_REQUIRED, MANUALLY_ADJUSTED
  adjustedAmount     Float              @default(0)
  remainingAmount    Float?
  bankTransactionId  Int?
  bankTransaction    BankTransaction?   @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  reconciliationAudits ReconciliationAudit[]
  createdAt          DateTime           @default(now())
}

model PaymentReceived {
  id            Int         @id @default(autoincrement())
  jobMetadataId Int
  jobMetadata   JobMetadata @relation(fields: [jobMetadataId], references: [id], onDelete: Cascade)
  createdById   Int?
  createdBy     User?       @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: SetNull)
  amount        Float
  taxDeducted   Float       @default(0)
  imageUrl      String?
  summaryNotes  String
  createdAt     DateTime    @default(now())
}

model WorkCompletion {
  id            Int         @id @default(autoincrement())
  jobMetadataId Int         @unique
  jobMetadata   JobMetadata @relation(fields: [jobMetadataId], references: [id], onDelete: Cascade)
  createdById   Int?
  createdBy     User?       @relation("CreatedWorkCompletions", fields: [createdById], references: [id], onDelete: SetNull)
  status        String      @default("PENDING")
  amount        Float       @default(0)
  imageUrl      String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BankApproval {
  id            Int         @id @default(autoincrement())
  jobMetadataId Int         @unique
  jobMetadata   JobMetadata @relation(fields: [jobMetadataId], references: [id], onDelete: Cascade)
  createdById   Int?
  createdBy     User?       @relation("CreatedBankApprovals", fields: [createdById], references: [id], onDelete: SetNull)
  bankName      String?
  accountNumber String?
  amount        Float       @default(0)
  status        String      @default("PENDING")
  imageUrl      String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Comment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      User?    @relation("AdminComments", fields: [adminId], references: [id], onDelete: SetNull)
  senderRole String   @default("ADMIN")
  senderName String   @default("Fatma")
  adminName  String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Bank Statements uploaded by Admins for verification and auto/manual reconciliation.
model BankStatement {
  id               Int                @id @default(autoincrement())
  bankName         String
  accountNumber    String?
  statementPeriod  String?
  startDate        DateTime?
  endDate          DateTime?
  fileName         String
  fileHash         String             // SHA-256 hash for deduplication
  fileSize         Int?
  fileType         String?
  rawFileUrl       String?
  totalCredits     Float              @default(0)
  totalDebits      Float              @default(0)
  openingBalance   Float?
  closingBalance   Float?
  transactionCount Int                @default(0)
  status           String             @default("PROCESSED") // PROCESSED, ERROR
  notes            String?
  uploadedById     Int?
  uploadedBy       User?              @relation("UploadedStatements", fields: [uploadedById], references: [id], onDelete: SetNull)
  transactions     BankTransaction[]
  audits           ReconciliationAudit[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

/// Individual line items extracted from uploaded bank statements.
model BankTransaction {
  id               Int                @id @default(autoincrement())
  statementId      Int
  statement        BankStatement      @relation(fields: [statementId], references: [id], onDelete: Cascade)
  transactionDate  DateTime
  valueDate        DateTime?
  description      String
  referenceNo      String?
  chequeNo         String?
  debit            Float              @default(0)
  credit           Float              @default(0)
  balance          Float?
  transactionHash  String?            // MD5/SHA256 of date+desc+debit+credit+ref
  matchStatus      String             @default("UNMATCHED") // UNMATCHED, MATCHED, PARTIALLY_MATCHED, REVIEW_REQUIRED, MANUALLY_ADJUSTED
  reconciledAmount Float              @default(0)
  matchedExpenses  Expense[]
  otherExpenseId   Int?
  otherExpense     OtherExpense?      @relation(fields: [otherExpenseId], references: [id], onDelete: SetNull)
  audits           ReconciliationAudit[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

/// Non-complaint manual company expenses (Rent, Utilities, Salaries, Fuel, Vendor Payments, etc.)
model OtherExpense {
  id               Int                @id @default(autoincrement())
  expenseDate      DateTime           @default(now())
  category         String             // Rent, Utilities, Fuel, Salary, Vendor, Office, Hardware, Miscellaneous
  amount           Float
  paidTo           String             // Person or vendor name
  bankName         String?
  paymentMethod    String?            // Bank Transfer, Cash, Cheque, Online
  description      String
  referenceNo      String?
  attachmentUrl    String?
  status           String             @default("RECORDED") // RECORDED, MATCHED, CANCELLED
  adminNotes       String?
  createdById      Int?
  createdBy        User?              @relation("CreatedOtherExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]
  audits           ReconciliationAudit[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

/// Immutable audit trail tracking all automatic and manual reconciliation events.
model ReconciliationAudit {
  id               Int                @id @default(autoincrement())
  expenseId        Int?
  expense          Expense?           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  statementId      Int?
  statement        BankStatement?     @relation(fields: [statementId], references: [id], onDelete: Cascade)
  transactionId    Int?
  transaction      BankTransaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  otherExpenseId   Int?
  otherExpense     OtherExpense?      @relation(fields: [otherExpenseId], references: [id], onDelete: Cascade)
  adminId          Int?
  admin            User?              @relation("AdminReconciliationAudits", fields: [adminId], references: [id], onDelete: SetNull)
  adminName        String?
  action           String             // AUTO_MATCH, MANUAL_MATCH, MANUAL_ADJUST, UNMATCH, STATEMENT_UPLOAD, OTHER_EXPENSE_CREATED, OTHER_EXPENSE_DELETED
  previousStatus   String?
  newStatus        String?
  adjustedAmount   Float?
  comment          String?
  createdAt        DateTime           @default(now())
}